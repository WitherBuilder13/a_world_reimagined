{
  "type": "lithostitched:set_material_rule",
  "injection_type": "prepend",
  "material_rule": {
    "type": "minecraft:sequence",
    "sequence": [
      {
        "type": "minecraft:condition",
        "if_true": {
          "type": "minecraft:biome",
          "biome_is": [
            "a_world_reimagined:tundra",
            "a_world_reimagined:wooded_tundra"
          ]
        },
        "then_run": {
          "type": "minecraft:block",
          "result_state": "a_world_reimagined:permafrost"
        }
      }
    ]
  },
  "target_rules": "minecraft:overworld/biome_surface"
}