{
  "type": "lithostitched:set_material_rule",
  "injection_type": "prepend",
  "material_rule": {
    "type": "minecraft:condition",
    "if_true": {
      "type": "minecraft:biome",
      "biome_is": "a_world_reimagined:glacial_shore"
    },
    "then_run": {
      "type": "minecraft:sequence",
      "sequence": [
        {
          "type": "minecraft:condition",
          "if_true": {
            "type": "minecraft:noise_threshold",
            "max_threshold": 1.7976931348623157E308,
            "min_threshold": 1.2000000476837158,
            "noise": "minecraft:small_patch"
          },
          "then_run": {
            "type": "minecraft:block",
            "result_state": "minecraft:blue_ice"
          }
        },
        {
          "type": "minecraft:block",
          "result_state": "minecraft:packed_ice"
        }
      ]
    }
  },
  "target_rules": "minecraft:overworld/under_biome_surface"
}